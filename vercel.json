{
  "version": 2,
  "buildCommand": "npm run build && npm test",
  "outputDirectory": "public",
  "rewrites": [\n    {\n      "source": "/engine",\n      "destination": "/engine.html"\n    },
    {
      "source": "/field/:id",
      "destination": "/index.html"
    },
    {
      "source": "/w/:id",
      "destination": "/index.html"
    },
    {
      "source": "/studio/:id",
      "destination": "/index.html"
    },
    {
      "source": "/new/:kind",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
